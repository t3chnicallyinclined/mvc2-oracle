-- ============================================================================
-- 36f (2026-06-14): THE EXACT ParaType-5 SPRITE-EXPANSION + TRIANGULATION RECIPE
-- (ta_vtx.cpp cited, line-exact) that the client must reproduce to render the HUD
-- character-NAME sprites correctly, PLUS a flycast-faithful GROUND-TRUTH render of
-- the captured name frame (vframe 86530) proving the names ARE readable letters
-- (CABLE/SENTINEL/STORM tails legible) and the garble is purely the client treating
-- a PVR Sprite as a Polygon strip. CONFIRMS finding:hud_name_garble_is_paratype5_sprite.
-- This is the RE-side deliverable handed to mvc2-sprite-render-expert (owns buildHudTA).
-- feat/render-replica-live.
-- ============================================================================
USE NS re DB kb;

UPSERT source:hud_sprite_expand_recipe SET kind='code',
  ref='core/hw/pvr/ta_vtx.cpp: AppendSpriteVertexA L1047-1073, CaclulateSpritePlane L1075-1122, AppendSpriteVertexB L1124-1153, AppendSpriteParam L1010-1036 (isp.CullMode ^=1), ta_sprite_data dispatch L345-367; ta_structs.h TA_Sprite1A L544-549 (x0,y0,z0,x1,y1,z1,x2) + TA_Sprite1B L551-560 (y2,z2,x3,y3,ignore, v0,u0, v1,u1, v2,u2); core/hw/pvr/ta_util.cpp makePrimRestartIndex L368-444 + makeIndex L450 (rc.idx = poly->first+i for i in 0..count, no permutation absent inf verts); core/network/maplecast_oracle_hook.cpp collectHudQuads L3006-3066 (vidx[0..3]=first 4 rc.idx entries -> q.x/y/u/v[c]=rc.verts[vidx[c]]).',
  note='THE EXACT FLYCAST PVR-SPRITE (ParaType 5) EXPANSION, line-cited. A PVR sprite submits 3 EXPLICIT screen corners + their 3 UVs (TA_Sprite1A: corner0=(x0,y0,z0), corner1=(x1,y1,z1), corner2 x split across 1A.x2 + 1B.y2,z2; TA_Sprite1B UVs v0/u0,v1/u1,v2/u2 = corner0/1/2 UV) and the 4th corner xy (x3,y3) with NO stored z/uv. flycast lays the 4 expanded verts into rc.verts (AppendSpriteVertexA resizes +4, cv=&back()-3) in this FIXED array order:\n  cv[0] = P  : x=x3,y=y3 ; z,u,v are COMPUTED by CaclulateSpritePlane (NOT stored).\n  cv[1] = C  : x=x2 (=1A.x2), y=y2,z=z2 (1B) ; uv=(u2,v2).\n  cv[2] = A  : x=x0,y=y0,z=z0          ; uv=(u0,v0).\n  cv[3] = B  : x=x1,y=y1,z=z1          ; uv=(u1,v1).\nCaclulateSpritePlane sets A=cv[2],B=cv[3],C=cv[1],P=cv[0] and solves the affine PLANE:\n  AB=B-A, AC=C-A, AP=P-A ; k3=AC.x*AB.y - AC.y*AB.x ; k2=(AP.x*AB.y - AP.y*AB.x)/k3 ;\n  k1 = (AB.x==0) ? (P.y-A.y-k2*AC.y)/AB.y : (P.x-A.x-k2*AC.x)/AB.x ;\n  P.z = A.z + k1*AB.z + k2*AC.z ; P.u = A.u + k1*AB.u + k2*AC.u ; P.v = A.v + k1*AB.v + k2*AC.v.\nSo P (cv[0]) has a PLANE-INTERPOLATED UV valid for the whole quad as ONE plane (the engine maps the sprite with a single plane equation, NOT two affine triangles). AppendSpriteParam does isp.CullMode ^= 1 (cull flips). The hardware renders the 4 verts as the strip cv[0..3] = (P,C,A,B) -> triangles (P,C,A)+(C,A,B), shared diagonal C-A; with P`s plane UV the two tris are UV-consistent. EMPIRICAL VALIDATION (tools/render-replica-poc/_gt_find_p.mjs on the live capture): for each para=5 name quad, exactly ONE of the 4 captured verts is the plane-interpolation of the other 3 (err->0.000 for non-degenerate quads e.g. quad[42] err=0.0000, quad[45] err=0.0000), CONFIRMING the captured 4 verts ARE flycast`s expanded sprite verts incl the plane-derived P.';

UPSERT source:hud_name_groundtruth_render_2026_06_14 SET kind='oracle',
  ref='tools/render-replica-poc/_hud_cap_namegap/ (live capture vframe 86530, 114 quads, vram_prefix.bin 8MB + pvr_prefix.bin 32KB + hudq_tail.bin). Rendered VERBATIM through the client pvr2 path: tools/render-replica-poc/render_hudq.mjs --order 0,1,2,3 -> _REFERENCE_full_frame.png; 4x name-band crop _REFERENCE_nameband_4x.png. Decoder validated on the known-good FONT (0x4DF000 565 twiddled) via _gt_validate_decoder.mjs -> _font_validate.png reads clean ("TIME"+meter gauge+digits). CPU single-plane raster _gt_cpu_plane.mjs -> _GROUND_TRUTH_cpu.png. Diagonal experiments _gt_render_sprites.mjs/_gt_render2.mjs. Per-vertex P-detection _gt_find_p.mjs. Quad-perimeter audit _gt_quad_order.mjs.',
  note='FLYCAST-FAITHFUL GROUND TRUTH of the captured name frame (the render-expert`s pixel reference). KEY READABLE RESULT (_REFERENCE_nameband_4x.png, 4x): the para=5 name letters DO render as readable white italic glyphs through the verbatim pvr2 path at identity [0,1,2,3] -> the TAILS of each name are legible: "BLE"/"3LE" = CABLE, "INEL" = SENTINEL, "RM"/"TRM" = STORM; portraits (Cable/Storm faces) + red bars render CLEAN. So the texels + palette ARE correct and the names ARE these sprites. The garble = the LEADING portion of each name streaks into a coloured diagonal wedge (blue/yellow) because those sprites` captured 4-vert order is NOT a valid quad perimeter under the identity strip. QUANTIFIED (_gt_quad_order.mjs): of the 62 para=5 sprites, 30 have a captured array order that IS a valid quad perimeter (identity strip OK) and 32 do NOT (identity strip -> a BOWTIE/wrong-diagonal -> the streak). DECODER CAVEAT (do not be misled): decoding a single para=5 sprite`s 32x32 PAL4 tile STANDALONE (_name_tiles.png twiddled / _name_tiles_linear.png linear) shows NOISE, NOT a letter -- because each sprite is a THIN SUB-SLICE of a name (w=1..162 screen px, UV sub-rect 1..32 of its own 32x32 tile), not a whole glyph; the letters only resolve when the sprites are composited at their screen positions (the _REFERENCE render). The strideSel=1 bit (tcw bit25) on the name sprites is a NON-ISSUE for the client: ta_vtx/TexCache.cpp L363-394 take the TWIDDLED paletted path for fmt=5 scan=0 regardless of StrideSel (StrideSel only steers the planar/PL32 path, L328-344, which paletted textures never have), and the FONT-validated twiddle decode is what the engine uses.';

UPSERT finding:hud_sprite_paratype5_client_recipe SET
  statement='THE CLIENT RE-TILE RECIPE for the ParaType-5 HUD name sprites (deliverable for mvc2-sprite-render-expert; CLIENT-ONLY, no server change). PREMISE (confirmed): the 62 fmt=5 name quads carry pcw a2000009 = ParaType 5 (Sprite). collectHudQuads (oracle_hook.cpp L3055-3066) ALREADY captures the 4 flycast-EXPANDED sprite verts in rc.idx/array order with their final UVs -- incl the plane-interpolated P -- so the 4 captured (x[4],y[4],u[4],v[4],col[4]) ARE SUFFICIENT; collectHudQuads does NOT need to capture the pre-expansion 3 corners, and maplecast_replica_live.cpp needs no change (texels+palette already ship in the prefix, finding:hud_name_palette_coverage_ok). THE BUG: buildHudTA rewrites pcw->para=4 and re-tiles every quad as the IDENTITY strip [0,1,2,3] => triangles (v0,v1,v2)+(v1,v2,v3), shared diagonal v1-v2. For a SPRITE the captured array order is (P,C,A,B) [or a merge/autosort rotation of it], whose correct quad diagonal is C-A, NOT v1-v2; when the captured order is not a clean perimeter (32/62 cases) the identity strip makes a BOWTIE -> the colour-streak garble. THE FIX (client buildHudTA, when ParaType(captured pcw bits29-31)==5): do NOT emit the captured order blindly; re-tile the 4 verts as a CONVEX QUAD along its real diagonal. Concrete, robust, order-agnostic: (1) compute the centroid (mean of the 4 xy); (2) sort the 4 vert INDICES by atan2(y-cy, x-cx) to get the perimeter order pm[0..3]; (3) emit a triangle strip that triangulates the convex quad as a FAN on diagonal pm[0]-pm[2], e.g. strip vertex order [pm[1], pm[0], pm[2], pm[3]] (pvr2 _buildIndexBuffer: even i->(v0,v1,v2), odd i->(v1,v0,v2) => tris (pm1,pm0,pm2)+(pm0,pm2,pm3)) -- carry each vert`s CAPTURED u/v/col UNCHANGED (P keeps its plane UV). This makes each sprite a proper textured parallelogram with the engine`s own plane UV at the corners. For ParaType==4 polys KEEP the identity [0,1,2,3] (finding:hud_garble_one_truth_clientgrounded -- it is the engine`s native strip and is correct). NOTE: a 2-triangle affine split is a faithful approximation of the engine`s single-plane sprite mapping for these glyph tiles because the captured UVs are already planar-consistent (P = plane-interp of A,B,C, err->0.000); the ONLY thing the client must get right is the DIAGONAL (perimeter), which the centroid sort guarantees. VALIDATION GATE: render the captured frame at the new per-sprite order through render_hudq.mjs/pvr2 and confirm the name-band reads the same legible letters as _REFERENCE_nameband_4x.png with the leading-letter streaks GONE (currently only the trailing letters are clean). ALTERNATIVE (server, NOT preferred): tag ParaType-5 in the HudQuad wire so the client can branch without re-deriving ParaType from pcw -- unnecessary since pcw is already captured (q.pcw bits29-31).',
  status='confirmed', confidence='high', date='2026-06-14';

UPSERT finding:hud_name_letters_render_confirmed SET
  statement='THE NAMES ARE READABLE LETTERS (REFUTES any "names are absent / wrong texels / VRAM gap" alternate). A flycast-faithful render of the captured name frame (vframe 86530) through the verbatim client pvr2 path (source:hud_name_groundtruth_render_2026_06_14, _REFERENCE_nameband_4x.png) shows the para=5 sprite TAILS legibly spelling CABLE ("BLE"), SENTINEL ("INEL"), STORM ("RM") in white italic, with clean portraits + red bars. So: (a) texels + palette for the names ARE present and correct in the shipped prefix (the populated 0x415xxx block, palette banks 16/17/24 -- finding:hud_name_palette_coverage_ok); (b) the FONT-twiddle decode is the right format (validated on 0x4DF000, _font_validate.png reads "TIME"+gauge); (c) the strideSel=1 bit is a no-op for the client paletted-twiddle path. The ONLY defect is the ParaType-5 sprite re-tile (finding:hud_sprite_paratype5_client_recipe): 32 of 62 sprites bowtie under the identity strip, streaking the LEADING letters of each name into colour wedges while the trailing letters (whose captured order happens to be a valid perimeter) render clean. This pins the user-visible "names garble" to ONE client-side cause with a ONE-place fix in buildHudTA, and supplies the pixel reference to validate the fix against.',
  status='confirmed', confidence='high', date='2026-06-14';

RELATE finding:hud_sprite_paratype5_client_recipe->cites->source:hud_sprite_expand_recipe;
RELATE finding:hud_sprite_paratype5_client_recipe->cites->source:hud_name_groundtruth_render_2026_06_14;
RELATE finding:hud_sprite_paratype5_client_recipe->about->finding:hud_name_garble_is_paratype5_sprite;
RELATE finding:hud_sprite_paratype5_client_recipe->about->finding:hud_garble_one_truth_clientgrounded;
RELATE finding:hud_name_letters_render_confirmed->cites->source:hud_name_groundtruth_render_2026_06_14;
RELATE finding:hud_name_letters_render_confirmed->about->finding:hud_name_garble_is_paratype5_sprite;
RELATE finding:hud_name_letters_render_confirmed->about->finding:hud_name_palette_coverage_ok;
